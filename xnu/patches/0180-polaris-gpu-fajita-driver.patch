+			printf("SWEET GPU: cb1 sctlr %#x ttbr0 %#x%08x | smr2 sid 0: wrote %#x/%#x read %#x/%#x sGFSR %#x\n",
+			    gpu_rd_quiet(b1, GPU_SMMU_CB_SCTLR), gpu_rd_quiet(b1, GPU_SMMU_CB_TTBR0 + 4),
+			    gpu_rd_quiet(b1, GPU_SMMU_CB_TTBR0), want_s2, want_smr, got_s2, got_smr,
+			    gpu_rd_quiet(smmu, GPU_SMMU_SGFSR));
+			printf("SWEET GPU: cp context %s\n",
+			    (got_s2 == want_s2 && got_smr == want_smr) ? "took" : "DID NOT TAKE");
+		}
+
+		gpu_wr_quiet(smmu, GPU_SMMU_TLBIALLNSNH, 0);
+		for (int i = 0; i < 100; i++) {
+			if (!(gpu_rd_quiet(smmu, GPU_SMMU_sTLBGSTATUS) & 1u)) {
+				break;
+			}
+			gpu_wait_ms(1);
+		}
+		printf("SWEET GPU: smmu %s (sTLBGSTATUS %#x)\n",
+		    routed ? "routes sid 5 and 4 through context 0" : "DID NOT TAKE the stream table",
+		    gpu_rd_quiet(smmu, GPU_SMMU_sTLBGSTATUS));
+		if (!routed) {
+			return;
+		}
+	}
+
+	/* ---- HFI: start the queues and say hello ---- */
+	gpu_probe_wr("gmu hfi ctrl init", gmu, GPU_GMU_HFI_CTRL_INIT, 1);
+	uint32_t hfi_status = 0;
+	for (int i = 0; i < 100; i++) {
+		hfi_status = gpu_rd_quiet(gmu, GPU_GMU_HFI_STATUS);
+		if (hfi_status & 1u) {
+			break;
+		}
+		gpu_wait_ms(1);
+	}
+	printf("SWEET GPU: hfi ctrl status %#x %s, version info %#x\n", hfi_status,
+	    (hfi_status & 1u) ? "(THE HFI QUEUES ARE UP)" : "(no answer)",
+	    gpu_rd_quiet(gmu, 0x14604u));
+	if (!(hfi_status & 1u)) {
+		return;
+	}
+
+	/* H2F_MSG_INIT: header, 0, dump address, dump size, cold boot */
+	{
+		volatile uint32_t *cmd = (volatile uint32_t *)(g + GPU_GMEM_HFI + 0xe0);
+		uint32_t msg[5];
+		msg[0] = HFI_QMARK_HDR(HFI_H2F_INIT, 5, 0);
+		msg[1] = 0;
+		msg[2] = GPU_VA_DUMP;
+		msg[3] = GPU_GMEM_DUMP_BYTES;
+		msg[4] = 1;                     /* GMU_COLD_BOOT */
+		for (unsigned i = 0; i < 5; i++) {
+			cmd[i] = msg[i];
+		}
+		volatile uint32_t *qh = (volatile uint32_t *)(g + GPU_GMEM_HFI + 4 * HFI_QTBL_HDR_DW);
+		qh[11] = (qh[11] + 5u) % 1024u;  /* write index */
+		__asm__ volatile("dmb oshst" ::: "memory");
+		gpu_probe_wr("gmu host2gmu intr", gmu, GPU_GMU_HOST2GMU_SET, 1);
+
+		uint32_t info = 0;
+		for (int i = 0; i < 100; i++) {
+			info = gpu_rd_quiet(gmu, GPU_GMU_GMU2HOST_INFO);
+			if (info & 1u) {
+				break;
+			}
+			gpu_wait_ms(1);
+		}
+		printf("SWEET GPU: gmu2host intr info %#x %s\n", info,
+		    (info & 1u) ? "(the GMU answered)" : "(no answer)");
+		if (info & 1u) {
+			gpu_wr_quiet(gmu, GPU_GMU_GMU2HOST_CLR, 1);
+			volatile uint32_t *msgq = (volatile uint32_t *)(g + GPU_GMEM_HFI + 0x10e0);
+			uint32_t r = 0;
+			for (int i = 0; i < 8; i++) {
+				printf("SWEET GPU: hfi reply[%d] %#x\n", i, msgq[i]);
+				if (i == 0) {
+					r = msgq[i];
+				}
+			}
+			printf("SWEET GPU: hfi reply id %u type %u (2 = ACK)\n", r & 0xffu, (r >> 16) & 0xfu);
+		}
+
+		/* keep the queues for the messages that follow */
+		hfi_gmu = gmu;
+		hfi_cmd_qh = qh;
+		hfi_msg_qh = (volatile uint32_t *)(g + GPU_GMEM_HFI + 4 * (HFI_QTBL_HDR_DW + HFI_QHDR_DW));
+		hfi_cmd_data = (volatile uint32_t *)(g + GPU_GMEM_HFI + 0xe0);
+		hfi_msg_data = (volatile uint32_t *)(g + GPU_GMEM_HFI + 0x10e0);
+		/* The INIT acknowledgement above was read by hand and is four dwords:
+		 * the read index has to start after it, or the sender reads it again. */
+		hfi_msg_qh[10] = 4u;
+		__asm__ volatile("dmb oshst" ::: "memory");
+
+		/* H2F_MSG_FW_VER: one dword, the version we speak (1.10). */
+		{
+			uint32_t fwver[2] = { HFI_QMARK_HDR(HFI_H2F_FW_VER, 2, 0), 0x100a0000u };
+			int id = gpu_hfi_send(fwver, 2, "fw version");
+			printf("SWEET GPU: hfi firmware version exchange %s (firmware %u.%u)\n",
+			    id == 1 ? "ok" : "failed", 0x10070000u >> 24, (0x10070000u >> 16) & 0xffu);
+		}
+		/* H2F_MSG_TEST: two dwords, the numbers the GMU echoes back. */
+		{
+			uint32_t test[4] = { HFI_QMARK_HDR(5, 4, 0), 0x12345678u, 0x9abcdef0u, 0 };
+			int id = gpu_hfi_send(test, 4, "test");
+			printf("SWEET GPU: hfi test %s\n", id == 5 ? "ok" : "failed");
+		}
+
+		/* ---- stage 5: the GX rail and SPTPRAC ---- */
+		printf("SWEET GPU: --- stage 5: gx rail\n");
+		{
+			bool rail = gpu_gx_rail_on(gmu);
+			printf("SWEET GPU: gx rail %s\n", rail ? "on" : "NOT on");
+			if (rail && gpu_sptprac_on(gmu)) {
+				/* The GX domain itself: the same collapse bit as CX, at 0x100c. */
+				uint32_t gx = gpu_probe_rd("gpucc gx gdscr", cc, GPUCC_GX_GDSCR);
+				if (gx & GDSC_POWER_ON) {
+					printf("SWEET GPU: gx gdscr already on %#x\n", gx);
+				} else {
+					gpu_probe_wr("gpucc gx gdscr on", cc, GPUCC_GX_GDSCR,
+					    (gx & ~GDSC_SW_COLLAPSE) & ~GDSC_HW_CONTROL);
+					uint32_t now = 0;
+					for (int i = 0; i < 100; i++) {
+						now = gpu_rd_quiet(cc, GPUCC_GX_GDSCR);
+						if (now & GDSC_POWER_ON) {
+							break;
+						}
+						gpu_wait_ms(1);
+					}
+					printf("SWEET GPU: gx gdscr %#x -> %#x -> %s\n", gx, now,
+					    (now & GDSC_POWER_ON) ? "GX ON" : "GX STILL OFF");
+				}
+
+				/* The five clocks still off here (Bergamota's gpucc table). */
+				{
+					static const struct { const char *what; uint32_t off; } clk[] = {
+						{ "gpucc cx_apb",      0x1088u },
+						{ "gpucc cx_snoc_dvm", 0x108cu },
+						{ "gpucc gx_cxo",      0x1060u },
+						{ "gpucc gx_gmu",      0x1064u },
+						{ "gpucc gx_gfx3d",    0x1054u },
+					};
+					for (unsigned i = 0; i < sizeof(clk) / sizeof(clk[0]); i++) {
+						uint32_t v = gpu_rd_quiet(cc, clk[i].off);
+						if ((v & 1u) && !(v & CBCR_OFF)) {
+							printf("SWEET GPU: %s already %#x\n", clk[i].what, v);
+							continue;
+						}
+						gpu_probe_wr(clk[i].what, cc, clk[i].off, (v & ~CBCR_OFF) | 1u);
+						uint32_t now = gpu_rd_quiet(cc, clk[i].off);
+						for (int k = 0; k < 20 && (now & CBCR_OFF); k++) {
+							gpu_wait_ms(1);
+							now = gpu_rd_quiet(cc, clk[i].off);
+						}
+						printf("SWEET GPU: %s %#x -> %#x %s\n", clk[i].what, v, now,
+						    (now & CBCR_OFF) ? "(halted)" : "(running)");
+					}
+				}
+
+				/* The core, at last: reads are safe only with GX powered. */
+				if (gpu_rd_quiet(cc, GPUCC_GX_GDSCR) & GDSC_POWER_ON) {
+					uint32_t c0 = gpu_rd_quiet(gmu, GPU_GMU_AO_COUNTER_L);
+					uint32_t rbbm = gpu_probe_rd("gpu core rbbm status", gpu, GPU_CORE_RBBM_STATUS);
+					uint32_t cp1 = gpu_probe_rd("gpu core cp status1", gpu, GPU_CORE_CP_STATUS_1);
+					gpu_wait_ms(2);
+					uint32_t c1 = gpu_rd_quiet(gmu, GPU_GMU_AO_COUNTER_L);
+					printf("SWEET GPU: GPU ANSWERS: rbbm_status %#x, cp_status1 %#x, GMU counter %#x -> %#x (%s)\n",
+					    rbbm, cp1, c0, c1, c0 != c1 ? "ticking" : "still");
+
+					/* ---- stage 7a: the CP's hardware initialisation ---- */
+					printf("SWEET GPU: --- stage 7a: cp hw_init\n");
+					if (gpu_cp_hw_init(gpu) &&
+					    gpu_cp_start(gpu, g + GPU_CP_RING)) {
+						/* The zap is the only step that enters the secure
+						 * world, so it stays behind `zap=1`; once it has run
+						 * the CP can leave secure mode and take the NOP test,
+						 * which is the first real submission. */
+						int cp_zap = 0;
+						(void)PE_parse_boot_argn("zap", &cp_zap, sizeof(cp_zap));
+						if (cp_zap) {
+							printf("SWEET GPU: --- stage 7c: the zap shader\n");
+							if (gpu_zap_load(g, gmem_pa)) {
+								bool ok = false;
+								printf("SWEET GPU: --- stage 7d: out of secure mode, the first submission\n");
+								gpu_ring_emit(g + GPU_CP_RING,
+								    gpu_pkt7(GPU_CP_SET_SECURE_MODE, 1));
+								gpu_ring_emit(g + GPU_CP_RING, 0);
+								gpu_ring_flush(gpu, gpu_cp_wptr);
+								if (gpu_ring_wait_idle(gpu, "CP_SET_SECURE_MODE 0")) {
+									ok = gpu_cp_nop_test(gpu, g);
+									if (ok) {
+										ok = gpu_cp_fill_test(gpu, g);
+									}
+									if (ok) {
+										ok = gpu_client_va_test(gpu, g, gmem_pa);
+									}
+									if (ok) {
+										ok = gpu_cp_ib_test(gpu, g, gmem_pa);
+									}
+									if (ok) {
+										ok = gpu_bo_test(gpu, g);
+									}
+								}
+								int hold = 0;
+								(void)PE_parse_boot_argn("gpuhold", &hold, sizeof(hold));
+								if (ok && hold) {
+									/* Stage 8: keep everything live so the CP's
+									 * state survives the boot. */
+									gpu_kept_up = true;
+									gpu_blob = g;
+									gpu_core = gpu;
+									gpu_live = true;
+									printf("SWEET GPU: GPU KEPT UP: GMU live, OOB gpu held, "
+									    "zap authenticated, ring live at wptr %u\n",
+									    gpu_cp_wptr);
+									(void)gpu_abi_test();
+									gpu_dev_register();
+									SweetAdrenoPublish();
+								} else {
+									gpu_zap_shutdown();
+								}
+							}
+						}
+					} else {
+						printf("SWEET GPU: CP bring-up stopped before the NOP test\n");
+					}
+
+					if (gpu_kept_up) {
+						/* Stage 8: everything the ladder built has to
+						 * survive the boot, so stop here - the slumber
+						 * below and the GMU reset at the end of the
+						 * function would both take it away. */
+						printf("SWEET GPU: stage 8: GPU kept up, slumber and GMU reset skipped\n");
+						return;
+					}
+
+					/* a6xx_gmu_notify_slumber: give the rail back. */
+					gpu_probe_wr("gmu power counter off", gmu, GPU_GMU_POWER_COUNTER, 0);
+					gpu_probe_wr("gmu sptprac off", gmu, GPU_GMU_GX_SPTPRAC_POWER, 0x778001u);
+					{
+						uint32_t st = 0;
+						bool off = false;
+						for (int i = 0; i < 100; i++) {
+							st = gpu_rd_quiet(gmu, GPU_GMU_SPTPRAC_STATUS);
+							if (st & 0x4u) {
+								off = true;
+								break;
+							}
+							gpu_wait_ms(1);
+						}
+						printf("SWEET GPU: SPTPRAC off: %s (status %#x)\n", off ? "ok" : "TIMED OUT", st);
+					}
+					gpu_probe_wr("gmu slumber option", gmu, GPU_GMU_BOOT_SLUMBER, 1);
+					gpu_probe_wr("gmu oob slumber", gmu, GPU_GMU_HOST2GMU_SET,
+					    1u << (GPU_OOB_BOOT_SLUMBER + 16));
+					{
+						uint32_t info2 = 0;
+						bool ack = false;
+						for (int i = 0; i < 100; i++) {
+							info2 = gpu_rd_quiet(gmu, GPU_GMU_GMU2HOST_INFO);
+							if (info2 & (1u << (GPU_OOB_BOOT_SLUMBER + 24))) {
+								ack = true;
+								break;
+							}
+							gpu_wait_ms(1);
+						}
+						gpu_wr_quiet(gmu, GPU_GMU_GMU2HOST_CLR,
+						    1u << (GPU_OOB_BOOT_SLUMBER + 24));
+						uint32_t ps = gpu_rd_quiet(gmu, GPU_GMU_RPMH_POWER_STATE);
+						printf("SWEET GPU: slumber %s: RPMH_POWER_STATE %#x%s\n",
+						    ack ? "acknowledged" : "not acknowledged", ps,
+						    ps == GPU_HW_SLUMBER ? " (slumber)" : " (not slumber)");
+					}
+					gpu_probe_wr("gmu ahb fence allow", gmu, GPU_GMU_AO_AHB_FENCE, 0);
+				}
+			}
+		}
+	}
+	printf("SWEET GPU: stage 3e done\n");
+
+	/* Leave the GMU as Bergamota leaves it: in reset, so the next boot starts
+	 * from the state the boot loader expects. */
+	gpu_probe_wr("gmu sysreset end", gmu, GPU_GMU_SYSRESET, 1);
+	gpu_wait_ms(10);
+	printf("SWEET GPU: gmu sysreset at the end %#x\n", gpu_rd_quiet(gmu, GPU_GMU_SYSRESET));
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
