+#define DIPPER_ADDRESS_BEGIN      0
+#define DIPPER_ADDRESS_END        11
+#define DIPPER_HWCG_BEGIN         11
+#define DIPPER_HWCG_END           116
+#define DIPPER_HWCG_COMMIT_BEGIN  116
+#define DIPPER_HWCG_COMMIT_END    117
+#define DIPPER_CORE_BEGIN         117
+#define DIPPER_CORE_END           146
+#define DIPPER_PROTECT_BEGIN      146
+#define DIPPER_PROTECT_END        179
+
+static uint32_t dipper_writes, dipper_differs;
+
+static void
+dipper_put(vm_offset_t gpu, uint32_t word, uint32_t value)
+{
+	uint32_t back;
+
+	DIPPER_WR(gpu, word, value);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	back = DIPPER_RD(gpu, word);
+	if (back != value && dipper_differs++ < 8) {
+		printf("SWEET GPU: dipper init word %#x wrote %#010x read %#010x\n", word, value, back);
+	}
+	dipper_writes++;
+}
+
+static void
+dipper_range(vm_offset_t gpu, const char *what, uint32_t first, uint32_t end)
+{
+	uint32_t before = dipper_differs;
+
+	for (uint32_t i = first; i < end; i++) {
+		dipper_put(gpu, dipper_a630_init[i].reg, dipper_a630_init[i].value);
+	}
+	printf("SWEET GPU: dipper init %s: %u entries, %u read back different\n",
+	    what, end - first, dipper_differs - before);
+}
+
+/* GMU word offsets used by Linux's a6xx_set_hwcg and the busy/power counter block. */
+#define DIPPER_GMU_AO_CGC_MODE_W      0x9309u
+#define DIPPER_GMU_AO_CGC_DELAY_W     0x930au
+#define DIPPER_GMU_AO_CGC_HYST_W      0x930bu
+#define DIPPER_GMU_AO_BUSY_MASK_W     0x930eu
+#define DIPPER_GMU_GX_SPTPRAC_CLK_W   0x0080u
+#define DIPPER_GMU_PWR_CNT_ENABLE_W   0x5040u
+#define DIPPER_GMU_PWR_CNT_SELECT0_W  0x5041u
+
+void
+sweet_dipper_hw_init(vm_offset_t gpu, vm_offset_t gmu)
+{
+	uint32_t clock_cntl, v;
+
+	dipper_writes = 0;
+	dipper_differs = 0;
+	printf("SWEET GPU: dipper-xnu hw_init table: %u entries (ADDRESS %u..%u, HWCG %u..%u,"
+	    " CORE %u..%u, PROTECT %u..%u; SECVID and IRQ skipped)\n",
+	    (uint32_t)(sizeof(dipper_a630_init) / sizeof(dipper_a630_init[0])),
+	    DIPPER_ADDRESS_BEGIN, DIPPER_ADDRESS_END, DIPPER_HWCG_BEGIN, DIPPER_HWCG_END,
+	    DIPPER_CORE_BEGIN, DIPPER_CORE_END, DIPPER_PROTECT_BEGIN, DIPPER_PROTECT_END);
+
+	dipper_range(gpu, "ADDRESS", DIPPER_ADDRESS_BEGIN, DIPPER_ADDRESS_END);
+
+	/* a6xx_set_hwcg: GMU gating mode/delay/hysteresis, then read RBBM_CLOCK_CNTL */
+	DIPPER_WR(gmu, DIPPER_GMU_AO_CGC_MODE_W, 0x20202u);
+	DIPPER_WR(gmu, DIPPER_GMU_AO_CGC_DELAY_W, 0x10111u);
+	DIPPER_WR(gmu, DIPPER_GMU_AO_CGC_HYST_W, 0x5555u);
+	clock_cntl = DIPPER_RD(gpu, 0xaeu);
+	printf("SWEET GPU: dipper init RBBM_CLOCK_CNTL %#010x\n", clock_cntl);
+	if (clock_cntl == 0x8aa8aa02u) {
+		printf("SWEET GPU: dipper init: HWCG already on, HWCG/HWCG_COMMIT skipped\n");
+	} else {
+		v = DIPPER_RD(gmu, DIPPER_GMU_GX_SPTPRAC_CLK_W);
+		DIPPER_WR(gmu, DIPPER_GMU_GX_SPTPRAC_CLK_W, v & ~1u);
+		dipper_range(gpu, "HWCG", DIPPER_HWCG_BEGIN, DIPPER_HWCG_END);
+		DIPPER_WR(gmu, DIPPER_GMU_GX_SPTPRAC_CLK_W, DIPPER_RD(gmu, DIPPER_GMU_GX_SPTPRAC_CLK_W) | 1u);
+		dipper_range(gpu, "HWCG_COMMIT", DIPPER_HWCG_COMMIT_BEGIN, DIPPER_HWCG_COMMIT_END);
+	}
+
+	dipper_range(gpu, "CORE", DIPPER_CORE_BEGIN, DIPPER_CORE_END);
+
+	/* hw_init:1369-1373: GMU busy mask and power counters */
+	DIPPER_WR(gmu, DIPPER_GMU_AO_BUSY_MASK_W, 0xff000000u);
+	v = DIPPER_RD(gmu, DIPPER_GMU_PWR_CNT_SELECT0_W);
+	DIPPER_WR(gmu, DIPPER_GMU_PWR_CNT_SELECT0_W, (v & ~0xffu) | (1u << 5));
+	DIPPER_WR(gmu, DIPPER_GMU_PWR_CNT_ENABLE_W, 1u);
+
+	dipper_range(gpu, "PROTECT", DIPPER_PROTECT_BEGIN, DIPPER_PROTECT_END);
+	printf("SWEET GPU: dipper init: %u writes, %u read back different; RBBM_STATUS %#x"
+	    " CP_STATUS1 %#x\n", dipper_writes, dipper_differs,
+	    DIPPER_RD(gpu, 0x210u), DIPPER_RD(gpu, 0x825u));
+}
