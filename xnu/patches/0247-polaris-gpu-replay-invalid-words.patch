+/* 0247: replace words the SQE would reject as an invalid PM4 packet with a CP_NOP. */
+static void
+gpu_replay_fix_invalid(uint32_t *p, uint32_t words, uint32_t *fixed)
+{
+	for (uint32_t i = 0; i < words; ) {
+		uint32_t w = p[i];
+		if ((w >> 28) == 7 && ((w >> 24) & 0xF) == 0) {
+			i += 1 + (w & 0x3fff);
+		} else if ((w >> 28) == 4) {
+			i += 1 + (w & 0x7f);
+		} else {
+			p[i] = 0x70000000u;
+			(*fixed)++;
+			i++;
+		}
+	}
+}
