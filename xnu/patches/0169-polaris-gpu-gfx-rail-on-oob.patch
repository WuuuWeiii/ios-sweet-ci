diff --git a/bsd/dev/polaris_gpu_cm3.c b/bsd/dev/polaris_gpu_cm3.c
--- a/bsd/dev/polaris_gpu_cm3.c
+++ b/bsd/dev/polaris_gpu_cm3.c
@@ -743,6 +743,41 @@
 
 
 
+	/* The DT says this GPU has qcom,gpu-quirk-hfi-use-reg: the power
+	 * requests to the GMU go through the OOB interrupt registers.  Vendor's
+	 * a6xx_gfx_rail_on() therefore runs before a6xx_gmu_hfi_start(). */
+	if (mode >= 25) {
+		uint32_t gx = 1, mx = 1;
+		if (mode == 26) { gx = 1; mx = 2; }
+		if (mode == 27) { gx = 2; mx = 4; }
+		if (mode == 28) { gx = 0; mx = 0; }
+		cm3_wr(gmu, cm3_reg(GMU_BOOT_SLUMBER), 0u);        /* OOB_BOOT_OPTION */
+		cm3_wr(gmu, cm3_reg(GMU_GX_VOTE_IDX), gx);
+		cm3_wr(gmu, cm3_reg(GMU_MX_VOTE_IDX), mx);
+		cm3_wr(gmu, cm3_reg(GMU_HOST2GMU_INTR_SET), 1u << 22);
+		uint32_t info = 0;
+		for (int i = 0; i < 2000; i++) {
+			info = cm3_rd(gmu, cm3_reg(GMU_GMU2HOST_INFO));
+			if (info & (1u << 30)) {
+				break;
+			}
+			delay(1);
+		}
+		printf("POLARIS GPUGFX: rail_on gx=%u mx=%u ack_info=%08x power=%08x intr2=%08x\n",
+		    gx, mx, info, cm3_rd(gmu, cm3_reg(0x1F8ECu)),
+		    cm3_rd(gmu, cm3_reg(GMU_GMU2HOST_INFO)));
+		cm3_wr(gmu, cm3_reg(GMU_GMU2HOST_INTR_CLR), 1u << 30);
+		cm3_wr(gmu, cm3_reg(GMU_HOST2GMU_INTR_SET), 1u << 30);
+		if (mode == 29) {
+			vm_offset_t gpu = ml_io_map(0x05000000ULL, 0x00010000ULL);
+			printf("POLARIS GPUGFX: rbbm=%08x power=%08x\n",
+			    gpu ? cm3_rd(gpu, 0x210u * 4u) : 0xdead,
+			    cm3_rd(gmu, cm3_reg(0x1F8ECu)));
+			sweet_dbg_dump_now();
+			return;
+		}
+	}
+
 	/* M3: HFI queues. Clear the msg-queue interrupt mask, start HFI, wait. */
 	if (mode == 6) {
 		cm3_wr(gmu, cm3_reg(GMU_HFI_CTRL_STATUS), 0u);
