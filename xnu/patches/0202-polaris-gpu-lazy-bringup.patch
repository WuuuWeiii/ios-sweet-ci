diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -1949,9 +1949,14 @@
 }
 
 /* devfs: one node, no per-open state, the GPU is a single system resource. */
+extern void sweet_gpu_lazy_start(void);
 static int
 sweet_gpu_dev_open(dev_t dev, int flags, int devtype, struct proc *p)
 {
+	/* lazy mode: the first client runs the hardware bring-up, not the boot */
+	if (!gpu_live && gpu_lazy_pending) {
+		sweet_gpu_lazy_start();
+	}
 	int rc = gpu_live ? 0 : ENXIO;
 
 	/* The tool's console output can scroll away or go to a serial port we do not
@@ -2027,9 +2032,48 @@
 	.d_type   = 0,
 };
 
+static bool gpu_node_created;
+static bool gpu_published;
+static bool gpu_lazy_pending;
+static bool gpu_lazy_started;
+static void sweet_gpu_probe_now(void);
+
+/*
+ * polaris lazy mode (adrenolazy=1): the heavy bring-up runs from the first client that
+ * opens /dev/sweetgpu instead of from the boot path.
+ */
+void
+sweet_gpu_lazy_start(void)
+{
+	if (!gpu_lazy_pending || gpu_lazy_started) {
+		return;
+	}
+	gpu_lazy_started = true;
+	gpu_lazy_pending = false;
+	printf("SWEET GPU: lazy mode: hardware bring-up from the first client\n");
+	sweet_gpu_probe_now();
+	printf("SWEET GPU: lazy mode: bring-up returned, live=%d\n", gpu_live ? 1 : 0);
+}
+
+void
+sweet_gpu_lazy_register(void)
+{
+	gpu_lazy_pending = true;
+	gpu_dev_register();
+	if (!gpu_published) {
+		gpu_published = true;
+		SweetAdrenoPublish();
+	}
+	printf("SWEET GPU: lazy mode: devfs + SweetAdreno630 published, bring-up deferred\n");
+}
+
 static void
 gpu_dev_register(void)
 {
+	if (gpu_node_created) {
+		return;
+	}
+	gpu_node_created = true;
 	int major = cdevsw_add(-1, &sweet_gpu_cdevsw);
 
 	if (major < 0) {
@@ -2601,6 +2645,14 @@
 	uint32_t delay = 0;
 	thread_t t = NULL;
 
+	{
+		uint32_t lazy = 0;
+		PE_parse_boot_argn("adrenolazy", &lazy, sizeof(lazy));
+		if (lazy) {
+			sweet_gpu_lazy_register();
+			return;
+		}
+	}
 	PE_parse_boot_argn("adrenodelay", &delay, sizeof(delay));
 	if (delay != 0) {
 		if (kernel_thread_start(sweet_gpu_probe_thread, NULL, &t) == KERN_SUCCESS) {
