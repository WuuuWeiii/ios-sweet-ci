diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -2887,7 +2887,13 @@
 	 * handshake first could leave the firmware waiting for votes nobody
 	 * answers. Its mask (0xf11) is the next thing to try if it will not run. */
 	gpu_probe_wr("gmu inter-frame ctrl", gmu, GPU_GMU_PWR_COL_INTER_FRAME, 0x9c40400);
-	gpu_probe_wr("gmu rpmh ctrl", gmu, GPU_GMU_RPMH_CTRL, 0xf11);   /* interface + LLC/DDR/MX/CX/GFX votes */
+	int polaris_rpmh_on = 1;
+	(void)PE_parse_boot_argn("polarisgpurpmh", &polaris_rpmh_on, sizeof(polaris_rpmh_on));
+	if (polaris_rpmh_on) {
+		gpu_probe_wr("gmu rpmh ctrl", gmu, GPU_GMU_RPMH_CTRL, 0xf11);   /* interface + LLC/DDR/MX/CX/GFX votes */
+	} else {
+		printf("SWEET GPU: polaris: RPMH_CTRL left alone (polarisgpurpmh=0)\n");
+	}
 	gpu_probe_wr("gmu boot config", gmu, GPU_GMU_BOOT_CONFIG, 0x02);
 	gpu_probe_wr("gmu fence range", gmu, GPU_GMU_AHB_FENCE_RANGE, 0x80000000u | (0xau << 18) | 0xa0u);
 	gpu_probe_wr("gmu cm3 cfg", gmu, GPU_GMU_CM3_CFG, 0x4052);
@@ -2909,6 +2915,23 @@
 	}
 	printf("SWEET GPU: fw_init %#x %s\n", init,
 	    init == GPU_GMU_FW_RUNNING ? "(THE GMU FIRMWARE RUNS)" : "(the firmware did not start)");
+	printf("SWEET GPU: polaris: cpu alive right after the firmware start\n");
+	delay(1000);            /* 1 ms */
+	printf("SWEET GPU: polaris: cpu still alive 1 ms later\n");
+	delay(10000);           /* 10 ms */
+	printf("SWEET GPU: polaris: cpu still alive 11 ms later\n");
+	{
+		int reset_now = 0;
+		(void)PE_parse_boot_argn("polarisgpureset", &reset_now, sizeof(reset_now));
+		if (reset_now) {
+			printf("SWEET GPU: polaris: holding the GMU in reset right away\n");
+			gpu_probe_wr("gmu sysreset", gmu, GPU_GMU_SYSRESET, 1);
+			printf("SWEET GPU: polaris: sysreset reads %#x\n",
+			    gpu_rd_quiet(gmu, GPU_GMU_SYSRESET));
+			printf("SWEET GPU: polaris: returning with the GMU held in reset\n");
+			return;
+		}
+	}
 	/* The log lives at GPU address 0x60300000 and has no kernel mapping until the
 	 * SMMU stage maps it: reading it here is what panicked console53. */
 	printf("SWEET GPU: stage 3d done\n");
