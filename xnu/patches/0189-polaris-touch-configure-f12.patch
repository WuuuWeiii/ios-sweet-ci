+/* RMI4 register write: 0xff,page STOP, address, data bytes, STOP -- the mirror of
+ * the read protocol above. Needed for the F01 control registers: the IC reports no
+ * 2D data until F01 says it is configured. */
+static bool
+pt_write_reg(uint16_t reg, const uint8_t *data, unsigned len)
+{
+	bool ok = false;
+
+	if (!len || len > MAX_READ || !pt_start(false)) goto out;
+	if (!pt_write(I2C_ADDR << 1)) goto out;
+	if (!pt_write(0xff)) goto out;
+	if (!pt_write((uint8_t)(reg >> 8))) goto out;
+	pt_stop();
+	if (!pt_start(false)) goto out;
+	if (!pt_write(I2C_ADDR << 1)) goto out;
+	if (!pt_write((uint8_t)reg)) goto out;
+	for (unsigned i = 0; i < len; ++i) {
+		if (!pt_write(data[i])) goto out;
+	}
+	ok = true;
+out:
+	pt_stop();
+	if (!pt_idle()) {
+		return false;
+	}
+	return ok;
+}
