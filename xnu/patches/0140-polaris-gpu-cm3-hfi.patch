diff --git a/bsd/dev/polaris_gpu_cm3.c b/bsd/dev/polaris_gpu_cm3.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/polaris_gpu_cm3.c
@@ -0,0 +1,252 @@
+/*
+ * Polaris A630v2 M2b/M3: release the GMU's CM3 from reset and bring up the
+ * HFI queues.
+ *
+ * Sequence from the vendor kgsl a6xx driver (adreno_a6xx.c a6xx_gmu_fw_start
+ * + a6xx_gmu_start + a6xx_gmu_hfi_start) with the SDM845 GPU/GMU register
+ * windows.  The HFI queue table lives in a 16 KiB payload blob (GPU-HFI);
+ * its physical address is passed to the firmware as the queue table address.
+ * The CPU display path is untouched; boot-arg polarisgpucm3=1.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <kern/clock.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern bool polaris_touch_i2c_board(void);
+
+#define GCC_PA              0x00100000ULL
+#define GCC_SIZE            0x00090000ULL
+#define GPUCC_PA            0x05090000ULL
+#define GPUCC_SIZE          0x00010000ULL
+#define GMU_PA              0x0506a000ULL
+#define GMU_SIZE            0x00030000ULL
+#define GMU_WINDOW_OFF      0x0006a000u
+
+#define GPUCC_CX_GDSCR      0x106cu
+#define GPUCC_CX_HW_CTRL    0x1540u
+#define GPUCC_CX_GMU_CBCR   0x1098u
+#define GPUCC_CXO_CBCR      0x109cu
+#define GPUCC_GMU_RCGR      0x1120u
+
+#define GDSC_SW_COLLAPSE    (1u << 0)
+#define GDSC_POWER_ON       (1u << 31)
+#define CBCR_ENABLE         (1u << 0)
+
+#define GMU_CM3_ITCM_START  0x1B400u
+#define GMU_CM3_SYSRESET    0x1F800u
+#define GMU_CM3_BOOT_CONFIG 0x1F801u
+#define GMU_CM3_FW_INIT     0x1F81Cu
+#define GMU_SYS_BUS_CONFIG  0x1F40Fu
+#define GMU_PWR_COL_IFPC    0x1F8C0u
+#define GMU_HFI_CTRL_STATUS 0x1F980u
+#define GMU_HFI_SFR_ADDR    0x1F982u
+#define GMU_HFI_QTBL_INFO   0x1F984u
+#define GMU_HFI_QTBL_ADDR   0x1F985u
+#define GMU_HFI_CTRL_INIT   0x1F986u
+#define GMU_GMU2HOST_MASK   0x1F993u
+#define GMU_GENERAL_7       0x1F9CCu
+#define GMU_AHB_FENCE_RANGE0 0x23B11u
+
+#define GMU_FW_WORDS        8192u
+#define HFI_BLOB_SIZE       0x4000u
+#define HFI_QUEUE_SIZE      4096u
+#define HFI_QUEUE_MAX       3u
+#define HFI_TABLE_SIZE      (6u * 4u + 48u * HFI_QUEUE_MAX)   /* 168 bytes */
+#define HFI_QUEUE_OFF(i)    (HFI_TABLE_SIZE + (i) * (HFI_QUEUE_SIZE + 16u))
+
+#define BOOT_RESULT_OK      0xBABEFACEu
+#define FENCE_RANGE_MASK    0x80A008A0u
+
+static uint32_t
+cm3_rd(vm_offset_t base, uint32_t gmuoff)
+{
+	uint32_t v = *(volatile uint32_t *)(base + gmuoff);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+cm3_wr(vm_offset_t base, uint32_t gmuoff, uint32_t v)
+{
+	*(volatile uint32_t *)(base + gmuoff) = v;
+	__asm__ volatile ("dsb sy; dmb oshld" ::: "memory");
+}
+
+static uint32_t
+cm3_reg(uint32_t reg_dword)
+{
+	return (reg_dword << 2) - GMU_WINDOW_OFF;
+}
+
+static bool
+cm3_blob(const char *name, uint64_t want, uint64_t *phys, uint64_t *size, uint64_t *va)
+{
+	DTEntry mmap;
+	const void *value = NULL;
+	unsigned int length = 0;
+
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mmap) != kSuccess ||
+	    SecureDTGetProperty(mmap, name, &value, &length) != kSuccess ||
+	    value == NULL || length != 16) {
+		return false;
+	}
+	memcpy(phys, value, sizeof(*phys));
+	memcpy(size, (const uint8_t *)value + sizeof(*phys), sizeof(*size));
+	if (*size != want) {
+		return false;
+	}
+	*va = ml_io_map((vm_offset_t)*phys, (vm_size_t)*size);
+	return *va != 0;
+}
+
+void
+polaris_gpu_cm3(void)
+{
+	int optin = 0;
+	(void)PE_parse_boot_argn("polarisgpucm3", &optin, sizeof(optin));
+	if (optin != 1 || !polaris_touch_i2c_board()) {
+		return;
+	}
+
+	uint64_t fw_pa = 0, fw_size = 0, fw_va = 0;
+	uint64_t hfi_pa = 0, hfi_size = 0, hfi_va = 0;
+	if (!cm3_blob("GPU-GMU", GMU_FW_WORDS * 4u, &fw_pa, &fw_size, &fw_va)) {
+		printf("POLARIS GPUM2b: GPU-GMU blob missing/wrong size\n");
+		return;
+	}
+	if (!cm3_blob("GPU-HFI", HFI_BLOB_SIZE, &hfi_pa, &hfi_size, &hfi_va)) {
+		printf("POLARIS GPUM2b: GPU-HFI blob missing/wrong size\n");
+		return;
+	}
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	vm_offset_t gpucc = ml_io_map(GPUCC_PA, GPUCC_SIZE);
+	vm_offset_t gmu = ml_io_map(GMU_PA, GMU_SIZE);
+	if (gcc == 0 || gpucc == 0 || gmu == 0) {
+		printf("POLARIS GPUM2b: mapping failed (gcc %p gpucc %p gmu %p)\n",
+		    (void *)gcc, (void *)gpucc, (void *)gmu);
+		return;
+	}
+
+	/* CX on + GMU clocks (same sequence as M1). */
+	uint32_t gdscr = cm3_rd(gpucc, GPUCC_CX_GDSCR);
+	uint32_t hw = cm3_rd(gpucc, GPUCC_CX_HW_CTRL);
+	if (((gdscr | hw) & GDSC_POWER_ON) == 0) {
+		cm3_wr(gpucc, GPUCC_CX_GDSCR, gdscr & ~GDSC_SW_COLLAPSE);
+		for (int i = 0; i < 500; i++) {
+			if (((cm3_rd(gpucc, GPUCC_CX_GDSCR) | cm3_rd(gpucc, GPUCC_CX_HW_CTRL)) & GDSC_POWER_ON) != 0) {
+				break;
+			}
+			delay(1);
+		}
+	}
+	if (((cm3_rd(gpucc, GPUCC_CX_GDSCR) | cm3_rd(gpucc, GPUCC_CX_HW_CTRL)) & GDSC_POWER_ON) == 0) {
+		printf("POLARIS GPUM2b: CX did not come on, stopping\n");
+		return;
+	}
+	cm3_wr(gpucc, GPUCC_CXO_CBCR, cm3_rd(gpucc, GPUCC_CXO_CBCR) | CBCR_ENABLE);
+	cm3_wr(gpucc, GPUCC_GMU_RCGR + 4, (cm3_rd(gpucc, GPUCC_GMU_RCGR + 4) & ~0x371fu) | (6u << 8) | 2u);
+	cm3_wr(gpucc, GPUCC_GMU_RCGR, cm3_rd(gpucc, GPUCC_GMU_RCGR) | 1u);
+	for (int i = 0; i < 100; i++) {
+		if ((cm3_rd(gpucc, GPUCC_GMU_RCGR) & 1u) == 0) {
+			break;
+		}
+		delay(1);
+	}
+	cm3_wr(gpucc, GPUCC_CX_GMU_CBCR, cm3_rd(gpucc, GPUCC_CX_GMU_CBCR) | CBCR_ENABLE);
+
+	/* TCM retention and firmware words. */
+	cm3_wr(gmu, cm3_reg(GMU_GENERAL_7), 1);
+	for (uint32_t i = 0; i < GMU_FW_WORDS; i++) {
+		cm3_wr(gmu, cm3_reg(GMU_CM3_ITCM_START + i), cm3_rd(fw_va, i * 4));
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	/* Build the HFI queue table in the GPU-HFI blob (physical address is
+	 * what the firmware receives as its queue-table address). */
+	uint8_t *t = (uint8_t *)hfi_va;
+	memset(t, 0, (size_t)HFI_BLOB_SIZE);
+	uint32_t *w = (uint32_t *)t;
+	struct {
+		uint32_t id, prio;
+	} queues[HFI_QUEUE_MAX] = { {0, 10}, {4, 10}, {5, 40} };
+	/* table header */
+	w[0] = 0;                                  /* version */
+	w[1] = HFI_TABLE_SIZE >> 2;                /* size in dwords */
+	w[2] = 24u >> 2;                           /* qhdr0 offset */
+	w[3] = 48u >> 2;                           /* qhdr size */
+	w[4] = HFI_QUEUE_MAX;                      /* num_q */
+	w[5] = HFI_QUEUE_MAX;                      /* num_active_q */
+	for (uint32_t i = 0; i < HFI_QUEUE_MAX; i++) {
+		uint32_t *h = w + 6 + i * 12;
+		h[0] = 1;                              /* status active */
+		h[1] = (uint32_t)(hfi_pa + HFI_QUEUE_OFF(i));   /* queue address */
+		h[2] = (queues[i].id & 0xffu) | ((queues[i].prio & 0xffu) << 8);
+		h[3] = HFI_QUEUE_SIZE >> 2;            /* queue size in dwords */
+		h[4] = 0;                              /* var-size messages */
+		h[7] = 1;                              /* rx_wm */
+		h[8] = 1;                              /* tx_wm */
+		h[9] = 1;                              /* rx_req */
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("POLARIS GPUM2b: HFI table at phys 0x%llx (16 KiB), qsize=%u\n",
+	    (unsigned long long)hfi_pa, HFI_QUEUE_SIZE);
+
+	/* Program the GMU before releasing reset. */
+	cm3_wr(gmu, cm3_reg(GMU_CM3_FW_INIT), 0);
+	cm3_wr(gmu, cm3_reg(GMU_CM3_BOOT_CONFIG), 2u);           /* TCM_BOOT */
+	cm3_wr(gmu, cm3_reg(GMU_HFI_QTBL_ADDR), (uint32_t)hfi_pa);
+	cm3_wr(gmu, cm3_reg(GMU_HFI_QTBL_INFO), 1u);
+	cm3_wr(gmu, cm3_reg(GMU_AHB_FENCE_RANGE0), FENCE_RANGE_MASK);
+	cm3_wr(gmu, cm3_reg(GMU_HFI_SFR_ADDR), 0x06030100u);      /* A630v2 chipid */
+	cm3_wr(gmu, cm3_reg(GMU_SYS_BUS_CONFIG), 0x1u);
+	cm3_wr(gmu, cm3_reg(GMU_PWR_COL_IFPC), 0x9C40400u);
+
+	printf("POLARIS GPUM2b: pre-start: sysreset=%08x fwinit=%08x bootcfg=%08x hfiaddr=%08x\n",
+	    cm3_rd(gmu, cm3_reg(GMU_CM3_SYSRESET)), cm3_rd(gmu, cm3_reg(GMU_CM3_FW_INIT)),
+	    cm3_rd(gmu, cm3_reg(GMU_CM3_BOOT_CONFIG)), cm3_rd(gmu, cm3_reg(GMU_HFI_QTBL_ADDR)));
+
+	/* Reset the CM3, then let it run. */
+	cm3_wr(gmu, cm3_reg(GMU_CM3_SYSRESET), 1u);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	cm3_wr(gmu, cm3_reg(GMU_CM3_SYSRESET), 0u);
+
+	uint32_t result = 0;
+	bool booted = false;
+	for (int i = 0; i < 200; i++) {
+		result = cm3_rd(gmu, cm3_reg(GMU_CM3_FW_INIT));
+		if (result == BOOT_RESULT_OK) {
+			booted = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("POLARIS GPUM2b: CM3 boot result %08x (%s) after ~%d ms; fwinit=%08x\n",
+	    result, booted ? "0xBABEFACE OK" : "not ready", 0, cm3_rd(gmu, cm3_reg(GMU_CM3_FW_INIT)));
+	if (!booted) {
+		printf("POLARIS GPUM2b: CM3 did not reach BABEFACE; stopping before HFI\n");
+		return;
+	}
+
+	/* M3: HFI queues. Clear the msg-queue interrupt mask, start HFI, wait. */
+	uint32_t mask = cm3_rd(gmu, cm3_reg(GMU_GMU2HOST_MASK));
+	cm3_wr(gmu, cm3_reg(GMU_GMU2HOST_MASK), mask & ~1u);
+	cm3_wr(gmu, cm3_reg(GMU_HFI_CTRL_INIT), 1u);
+	uint32_t hfi = 0;
+	bool hfi_ok = false;
+	for (int i = 0; i < 500; i++) {
+		hfi = cm3_rd(gmu, cm3_reg(GMU_HFI_CTRL_STATUS));
+		if (hfi & 1u) {
+			hfi_ok = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("POLARIS GPUM2b: HFI ctrl status %08x (%s)\n", hfi, hfi_ok ? "queues up" : "not ready");
+	printf("POLARIS GPUM2b: done: CM3 runs=%s HFI=%s; GX/CP still untouched\n",
+	    booted ? "yes" : "no", hfi_ok ? "yes" : "no");
+}
+#endif
