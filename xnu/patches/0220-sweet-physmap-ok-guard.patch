diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -6865,10 +6865,40 @@
  * Invalidates all of the instruction cache on a physical page and
  * pushes any dirty data from the data cache for the same physical page
  */
+extern unsigned long gPhysBase, real_phys_size;
+
+/*
+ * Some pages handed to the cache-maintenance helpers below are outside the kernel
+ * physmap (observed PA 0xa750000 when the phys base is 0x100000000). phystokv_range()
+ * panics for those, which reset the phone in the middle of the GPU tests; the pages are
+ * uncached/WC, where the maintenance is a no-op anyway, so skip it with a one-shot note.
+ */
+static boolean_t
+sweet_pa_in_physmap(pmap_paddr_t pa)
+{
+	return !((pa < (pmap_paddr_t)gPhysBase) ||
+	    ((pa - (pmap_paddr_t)gPhysBase) >= (pmap_paddr_t)real_phys_size));
+}
+
+static void
+sweet_skip_phys_sync(pmap_paddr_t pa, const char *who)
+{
+	static int warned;
+	if (!warned) {
+		warned = 1;
+		printf("SWEET PMAP: %s skipping out-of-physmap PA 0x%llx\n", who,
+		    (unsigned long long)pa);
+	}
+}
+
 void
 pmap_sync_page_data_phys(
 	ppnum_t pp)
 {
+	if (!sweet_pa_in_physmap((pmap_paddr_t)pp << PAGE_SHIFT)) {
+		sweet_skip_phys_sync((pmap_paddr_t)pp << PAGE_SHIFT, __func__);
+		return;
+	}
 	cache_sync_page(pp);
 }
 
@@ -6881,6 +6911,10 @@
 pmap_sync_page_attributes_phys(
 	ppnum_t pp)
 {
+	if (!sweet_pa_in_physmap((pmap_paddr_t)pp << PAGE_SHIFT)) {
+		sweet_skip_phys_sync((pmap_paddr_t)pp << PAGE_SHIFT, __func__);
+		return;
+	}
 	flush_dcache((vm_offset_t) (pp << PAGE_SHIFT), PAGE_SIZE, TRUE);
 }
 
