diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -264,9 +264,14 @@
 {
 	mount_t mp = vnode_mount(vp);
 	*cs_flags |= CS_SIGNED;
-	if (mp != NULL && (vfs_flags(mp) & MNT_ROOTFS)) {
-		*cs_flags |= CS_PLATFORM_BINARY;
-	}
+	(void)mp;
+	/*
+	 * polaris: do not set CS_PLATFORM_BINARY on every rootfs binary.
+	 * dyld only honours DYLD_* (the injected DYLD_INSERT_LIBRARIES) for a
+	 * platform binary when the process is debugged, so marking everything
+	 * platform silently defeats the library injection. The stand-in only needs
+	 * CS_SIGNED for its own checks.
+	 */
 	if (cs_blob != cs_blob->csb_ro_addr && cs_blob->csb_entitlements == NULL) {
 		sweet_amfi_attach_entitlements(cs_blob);
 	}
