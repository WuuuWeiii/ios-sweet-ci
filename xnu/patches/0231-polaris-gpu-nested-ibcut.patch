 		    gpu_cp_rd(gpu_core, 0x808u), gpu_cp_rd(gpu_core, 0x903u));
 		gpu_cp_wr(gpu_core, 0x908u, 1);
 		printf("SWEET GPU: CPDIAG sqe_stat1 %#x\n", gpu_cp_rd(gpu_core, 0x909u));
+		for (uint32_t s = 0; s < 4; s++) {
+			gpu_cp_wr(gpu_core, 0x908u, s);
+			printf("SWEET GPU: CPDIAG sqe_stat[%u] %#x\n", s, gpu_cp_rd(gpu_core, 0x909u));
+		}
+
 	}
 	return gpu_cp_seq;
 }
