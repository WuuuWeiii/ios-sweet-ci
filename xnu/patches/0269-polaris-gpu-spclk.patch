From: polaris research
Subject: [PATCH] 0269: enable the GMU SP/HLSQ clock bit (sweetspclk=1)

HLSQ_INVALIDATE_CMD (0xbb08) is the exact instruction the Linux-SQE replay dies on; both
Bergamota and UniXNU enable the GMU SPTPRAC clock bit before touching SP/HLSQ. Set word
0x80 bit 0 after SPTPRAC power-up and log both controls.

--- a/bsd/dev/sweet_dipper_init.c
+++ b/bsd/dev/sweet_dipper_init.c
@@ -253,6 +253,22 @@
 
 	dipper_writes = 0;
 	dipper_differs = 0;
+	/* 0269: enable the SP/HLSQ clock the GMU exposes (word 0x80, bit 0). Bergamota and the
+	 * UniXNU A740 driver both set this after SPTPRAC power-up; without it writes to SP/HLSQ
+	 * registers (e.g. HLSQ_INVALIDATE_CMD 0xbb08) can hang the bus. sweetspclk=1 only. */
+	{
+		int spc = 0;
+
+		if (PE_parse_boot_argn("sweetspclk", &spc, sizeof(spc)) && spc) {
+			uint32_t v = DIPPER_RD(gmu, 0x0080u);
+
+			DIPPER_WR(gmu, 0x0080u, v | 1u);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			printf("SWEET GPU: SPTPRAC clock control %#x -> %#x\n", v, DIPPER_RD(gmu, 0x0080u));
+			printf("SWEET GPU: SPTPRAC power control %#x, status %#x\n",
+			    DIPPER_RD(gmu, 0x0081u), DIPPER_RD(gmu, 0x50d0u));
+		}
+	}
 	printf("SWEET GPU: dipper-xnu hw_init table: %u entries (ADDRESS %u..%u, HWCG %u..%u,"
 	    " CORE %u..%u, PROTECT %u..%u; SECVID and IRQ skipped)\n",
 	    (uint32_t)(sizeof(dipper_a630_init) / sizeof(dipper_a630_init[0])),
