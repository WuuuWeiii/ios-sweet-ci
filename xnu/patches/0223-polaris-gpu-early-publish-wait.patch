+extern "C" void sweet_gpu_lazy_start(void);
+
+/* 0223: kick the lazy bring-up (if it has not run yet) and wait for the GPU to be live. */
+static bool
+sweet_wait_gpu_ready(void)
+{
+	if (sweet_gpu_ready()) {
+		return true;
+	}
+	sweet_gpu_lazy_start();
+	for (int i = 0; i < 18000 && !sweet_gpu_ready(); i++) {
+		IOSleep(10);             /* up to 180 s: level-9 bring-up is slow */
+	}
+	return sweet_gpu_ready();
+}
