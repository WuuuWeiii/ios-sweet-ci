 int
+/* polaris: does this exec path belong to one of our userland GPU tests? */
+static bool
+sweet_exec_interesting(const char *path)
+{
+	static const char *keys[3] = { "sweet", "osmesa", "/usr/local/bin/" };
+	unsigned i;
+
+	if (path == NULL) {
+		return false;
+	}
+	for (i = 0; i < 3; i++) {
+		const char *k = keys[i];
+		unsigned kl = (unsigned)strlen(k);
+		const char *p;
+
+		for (p = path; *p != 0; p++) {
+			if (strncmp(p, k, kl) == 0) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
