 	if (smmu == 0) {
@@ -2956,8 +2897,8 @@
 	}
 	/* 64 bits throughout: the payload sits above 4 GB, and the SMMU takes a
 	 * 40-bit output address in its descriptors and a 64-bit TTBR0. */
