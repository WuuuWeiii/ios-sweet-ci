+	/* polaris: the SMMU context and the HFI tables have to exist before the
+	 * firmware runs; it freezes the platform within ~10 ms of starting. */
+	if (level >= 9) {
 	/* ---- stage 3e: the GMU's memory, the SMMU context, and HFI ----------- */
