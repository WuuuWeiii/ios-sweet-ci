diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1451,6 +1451,10 @@
 int
 exit1(proc_t p, int rv, int *retval)
 {
+	if (strncmp(p->p_comm, "osmesa", 6) == 0 || strncmp(p->p_comm, "sweet", 5) == 0 ||
+	    strncmp(p->p_comm, "snapshottool", 12) == 0) {
+		printf("SWEET EXIT: %s pid %d rv %d\n", p->p_comm, p->p_pid, rv);
+	}
