@@ -2133,11 +2134,60 @@
  *	EDEADLK				Process is being terminated
  */
 /* polaris: the exec trace hook (M6 userland bring-up) */
+static char sweet_exec_last_path[128];
+static bool sweet_exec_last_interesting;
+
+static bool
+sweet_exec_contains(const char *s, const char *key)
+{
+	unsigned kl = (unsigned)strlen(key);
+	const char *p;
+
+	for (p = s; *p != 0; p++) {
+		if (strncmp(p, key, kl) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
 static void
 sweet_exec_note(struct image_params *imgp, const char *path)
 {
+	static const char *keys[3] = { "osmesa", "sweet", "/usr/local/bin/" };
+	unsigned i;
+
+	strlcpy(sweet_exec_last_path, path, sizeof(sweet_exec_last_path));
+	sweet_exec_last_interesting = false;
+	for (i = 0; i < 3; i++) {
+		if (sweet_exec_contains(path, keys[i])) {
+			sweet_exec_last_interesting = true;
+		}
+	}
 	printf("SWEET EXEC: %s (pid %d)\n", path, proc_pid(current_proc()));
+	if (sweet_exec_last_interesting) {
+		printf("SWEET EXEC ROOT: subsystem '%s' pid %d\n",
+		    imgp->ip_subsystem_root_path ? imgp->ip_subsystem_root_path : "(none)",
+		    proc_pid(current_proc()));
+	}
 	(void)imgp;
+}
+
+static void
+sweet_exec_stage(const char *stage, int error)
+{
+	if (sweet_exec_last_interesting) {
+		printf("SWEET EXEC STAGE %s -> %d (%s) pid %d\n", stage, error,
+		    sweet_exec_last_path, proc_pid(current_proc()));
+	}
+}
+
+static void
+sweet_exec_failed(int error)
+{
+	if (sweet_exec_last_interesting && error != 0) {
+		printf("SWEET EXEC FAIL: %s -> %d\n", sweet_exec_last_path, error);
+	}
 }
 
