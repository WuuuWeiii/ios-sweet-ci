diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -73,6 +73,32 @@
 	return v;
 }
 
+#define CBCR_CLK_ENABLE   (1u << 0)
+static void
+usb_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy; dmb oshld" ::: "memory");
+}
+
+/* Enable one GCC branch and wait for CLK_OFF to drop (bounded). */
+static bool
+usb_clk_enable(vm_offset_t gcc, uint32_t off)
+{
+	uint32_t v = usb_rd(gcc, off);
+	if (!(v & CBCR_CLK_OFF)) {
+		return true;
+	}
+	usb_wr(gcc, off, v | CBCR_CLK_ENABLE);
+	for (int i = 0; i < 200; i++) {
+		if (!(usb_rd(gcc, off) & CBCR_CLK_OFF)) {
+			return true;
+		}
+		delay(100);
+	}
+	return false;
+}
+
 void
 sweet_usb_probe(void)
 {
@@ -96,6 +122,19 @@
 		cbcr[i] = usb_rd(gcc, usb_cbcr[i].off);
 		printf("SWEET USB: clk %-12s CBCR 0x%08x (%s)\n", usb_cbcr[i].name, cbcr[i],
 		    (cbcr[i] & CBCR_CLK_OFF) ? "off" : "on");
+	}
+	/* Try to bring the branches up ourselves: on Polaris the shim may leave
+	 * UTMI and AHB2PHY gated, which makes every DWC3 command (ep0 included)
+	 * time out and the QUSB2 PHY read back as float. */
+	for (unsigned i = 0; i < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); i++) {
+		bool was_off = (cbcr[i] & CBCR_CLK_OFF) != 0;
+		if (usb_clk_enable(gcc, usb_cbcr[i].off) != true) {
+			printf("SWEET USB: clk %-12s enable timeout (CBCR 0x%08x)\n",
+			    usb_cbcr[i].name, usb_rd(gcc, usb_cbcr[i].off));
+		} else if (was_off) {
+			printf("SWEET USB: clk %-12s enabled (CBCR 0x%08x)\n",
+			    usb_cbcr[i].name, usb_rd(gcc, usb_cbcr[i].off));
+		}
 	}
 	/* DWC3 registers need the GDSC, the master clock and the config-NoC path. */
 	clocks_on = (gdscr & (1u << 31)) && !(cbcr[0] & CBCR_CLK_OFF) && !(cbcr[3] & CBCR_CLK_OFF);
@@ -132,6 +171,8 @@
 	 * PLL_CORE_INPUT_OVERRIDE 0x0a8, TEST1 0x254. */
 	printf("SWEET USB: QUSB2 PLL_STATUS 0x%08x PWR_CTRL1 0x%08x PORT_TUNE1 0x%08x TEST1 0x%08x\n",
 	    usb_rd(phy, 0x1a0), usb_rd(phy, 0x210), usb_rd(phy, 0x240), usb_rd(phy, 0x254));
+	printf("SWEET USB: QUSB2 TCSR 0x%08x 0x%08x 0x%08x\n",
+	    usb_rd(phy, 0x000), usb_rd(phy, 0x004), usb_rd(phy, 0x00c));
 }
 
