diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -1950,6 +1950,7 @@
 
 /* devfs: one node, no per-open state, the GPU is a single system resource. */
 extern void sweet_gpu_lazy_start(void);
+extern int hz;
 extern void sweet_gpu_lazy_register(void);
 static void gpu_dev_register(void);
 static void sweet_gpu_probe_now(void);
@@ -1963,6 +1964,12 @@
 	/* lazy mode: the first client runs the hardware bring-up, not the boot */
 	if (!gpu_live && gpu_lazy_pending) {
 		sweet_gpu_lazy_start();
+	}
+	/* another client may be running the bring-up: wait for it to finish */
+	if (!gpu_live && gpu_lazy_started) {
+		for (int i = 0; i < 1200 && !gpu_live && gpu_lazy_started; i++) {
+			(void)tsleep(&gpu_lazy_chan, PZERO, "gpuwait", hz / 10);
+		}
 	}
 	int rc = gpu_live ? 0 : ENXIO;
 
@@ -2055,6 +2062,7 @@
 	printf("SWEET GPU: lazy mode: hardware bring-up from the first client\n");
 	sweet_gpu_probe_now();
 	printf("SWEET GPU: lazy mode: bring-up returned, live=%d\n", gpu_live ? 1 : 0);
+	wakeup(&gpu_lazy_chan);
 }
 
 void
