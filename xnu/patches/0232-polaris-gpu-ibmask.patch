+/* 0232: PM4 helpers for the command-stream experiments. */
+static uint32_t
+sweet_pm4_parity0232(uint32_t v)
+{
+	return (0x9669u >> (0xfu & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^
+	    (v >> 16) ^ (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1u;
+}
+
+static void
+sweet_ib_mask(struct sweet_gem **objs, uint32_t nr_bos, uint64_t iova, uint32_t words,
+    uint32_t mask, uint32_t depth, uint32_t *patched)
+{
+	if (depth > 4) {
+		return;
+	}
+	struct sweet_gem *bo = NULL;
+	uint32_t off = 0;
+	for (uint32_t b = 0; b < nr_bos; b++) {
+		struct sweet_gem *t = objs[b];
+		if (t != NULL && t->kva != NULL && iova >= t->iova && iova < t->iova + t->size) {
+			bo = t;
+			off = (uint32_t)(iova - t->iova);
+			break;
+		}
+	}
+	if (bo == NULL || off + words * 4u > bo->size) {
+		return;
+	}
+	volatile uint32_t *p = (volatile uint32_t *)(bo->kva + off);
+	for (uint32_t i = 0; i + 1 < words; ) {
+		uint32_t w = p[i];
+		if ((w >> 28) == 7 && ((w >> 24) & 0xF) == 0) {
+			uint32_t op = (w >> 16) & 0x7f;
+			uint32_t cnt = w & 0x3fff;
+			if (op == mask) {
+				p[i] = 0x70000000u | cnt | (sweet_pm4_parity0232(cnt) << 15) |
+				    (0x10u << 16) | (sweet_pm4_parity0232(0x10u) << 23);
+				for (uint32_t k = 1; k <= cnt; k++) {
+					p[i + k] = 0;
+				}
+				(*patched)++;
+			} else if (op == 0x3f && cnt >= 3 && i + 3 < words) {
+				uint64_t t = (uint64_t)p[i + 1] | ((uint64_t)p[i + 2] << 32);
+				uint32_t tw = p[i + 3];
+				sweet_ib_mask(objs, nr_bos, t, tw, mask, depth + 1, patched);
+			}
+			i += 1 + cnt;
+		} else if ((w >> 28) == 4) {
+			i += 1 + (w & 0x7f);
+		} else {
+			i += 1;
+		}
+	}
+}
