+extern uintptr_t sweet_fb_pixels;
+extern uint32_t sweet_fb_width, sweet_fb_height, sweet_fb_rowbytes;
+
+#define SWEET_SHOT_FIRST_BLOCK  5500ULL        /* oops partition, 4 KiB blocks */
+#define SWEET_SHOT_MAX_BYTES    (1080u * 4u * 2400u)
+
+struct sweet_shot_header {
+	char     magic[8];
+	uint32_t version;
+	uint32_t width, height, rowbytes, bytes;
+};
+
+/* Dump the panel framebuffer into the oops partition after <seconds>. */
+static void
+sweet_fb_save_shot(void)
+{
+	struct sweet_shot_header h;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	uint32_t rowbytes = sweet_fb_rowbytes ? sweet_fb_rowbytes : sweet_fb_width * 4u;
+	uint32_t bytes = rowbytes * sweet_fb_height;
+	if (sweet_fb_pixels == 0 || sweet_fb_width == 0 || sweet_fb_height == 0 ||
+	    bytes == 0 || bytes > SWEET_SHOT_MAX_BYTES) {
+		printf("SWEET SHOT: no framebuffer (%ux%u)\n", sweet_fb_width, sweet_fb_height);
+		return;
+	}
+	bzero(&h, sizeof(h));
+	memcpy(h.magic, "SWEETSH!", 8);
+	h.version = 1;
+	h.width = sweet_fb_width;
+	h.height = sweet_fb_height;
+	h.rowbytes = rowbytes;
+	h.bytes = bytes;
+	lck_mtx_lock(&sweet_ufs_lock);
+	bzero(bounce, UFS_BLOCK);
+	memcpy(bounce, &h, sizeof(h));
+	(void)ufs_write_blocks_raw(SWEET_SHOT_FIRST_BLOCK, 1);
+	uint32_t nblk = (bytes + UFS_BLOCK - 1) / UFS_BLOCK;
+	for (uint32_t i = 0; i < nblk; i++) {
+		bzero(bounce, UFS_BLOCK);
+		uint32_t off = i * UFS_BLOCK;
+		uint32_t n = MIN(UFS_BLOCK, bytes - off);
+		memcpy(bounce, (const void *)(sweet_fb_pixels + off), n);
+		(void)ufs_write_blocks_raw(SWEET_SHOT_FIRST_BLOCK + 1 + i, 1);
+	}
+	(void)ufs_sync_cache();
+	lck_mtx_unlock(&sweet_ufs_lock);
+	printf("SWEET SHOT: framebuffer %ux%u saved at block %llu\n",
+	    sweet_fb_width, sweet_fb_height, SWEET_SHOT_FIRST_BLOCK);
+}
