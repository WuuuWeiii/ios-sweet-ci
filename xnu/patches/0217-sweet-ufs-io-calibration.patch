+/* Timed 1 MiB raw reads: the sampler prints these to tell slow I/O from slow CPU. */
+void
+sweet_ufs_cal(const char *when)
+{
+	if (!su.ready || !su.writable || su.nblocks < 2048) {
+		return;
+	}
+	uint64_t ns1 = 0, ns2 = 0;
+	for (int i = 0; i < 2; i++) {
+		lck_mtx_lock(&sweet_ufs_lock);
+		uint64_t t0 = mach_absolute_time();
+		int err = ufs_read_blocks(su.first_block + 1024 + (uint64_t)i * 256, 256);
+		uint64_t t1 = mach_absolute_time();
+		lck_mtx_unlock(&sweet_ufs_lock);
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(t1 - t0, &ns);
+		if (i == 0) {
+			ns1 = ns;
+		} else {
+			ns2 = ns;
+		}
+		if (err != 0) {
+			printf("SWEET IOCAL: read error %d\n", err);
+		}
+	}
+	printf("SWEET IOCAL: %s 1MiB read %llu ms, again %llu ms\n", when,
+	    ns1 / 1000000ull, ns2 / 1000000ull);
+}
