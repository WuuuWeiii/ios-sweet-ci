+	pgsm_wr(smmu, SMMU_SMR(0), 0x80000000u | 5u);
+	pgsm_wr(smmu, cb + SMMU_CB_TLBIALL, 0u);
+	pgsm_wr(smmu, cb + SMMU_CB_TLBSYNC, 0xFFFFFFFFu);
+
+	printf("POLARIS GPUM4: bank %u cb 0x%x ttbr0=%08x%08x tcr=%08x tcr2=%08x mair0=%08x sctlr=%08x cbar=%08x cba2r=%08x s2cr=%08x smr=%08x\n",
+	    bank, cb, pgsm_rd(smmu, cb + SMMU_CB_TTBR0 + 4u), pgsm_rd(smmu, cb + SMMU_CB_TTBR0),
+	    pgsm_rd(smmu, cb + SMMU_CB_TCR), pgsm_rd(smmu, cb + SMMU_CB_TCR2),
+	    pgsm_rd(smmu, cb + SMMU_CB_MAIR0), pgsm_rd(smmu, cb + SMMU_CB_SCTLR),
+	    pgsm_rd(smmu, gr1 + bank * 4u), pgsm_rd(smmu, gr1 + 0x800u + bank * 4u),
+	    pgsm_rd(smmu, SMMU_S2CR(0)), pgsm_rd(smmu, SMMU_SMR(0)));
+	printf("POLARIS GPUM4: HFI VA 0x60000000 -> PA 0x%llx (%u bytes), tables %llx/%llx/%llx\n",
+	    (unsigned long long)hfi_pa, hfi_size,
 	    (unsigned long long)t->l1_pa, (unsigned long long)t->l2_pa, (unsigned long long)t->l3_pa);
+	printf("POLARIS GPUM4: cb fsr=%08x far=%08x%08x fsynr0=%08x gfsr=%08x scr0=%08x\n",
