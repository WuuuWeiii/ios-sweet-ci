+	uint32_t tcr = (2u << 30) | 0x3500u | (64u - 32u);   /* TG0 4K, coherent walk, T0SZ 32 */
+	uint32_t sctlr = passthrough ? 0xE0u : SMMU_SCTLR_VAL;
+	uint32_t gr1 = 0x1000u;
+
+	/* ArmSmmu4KProgramDisabledContext order. */
