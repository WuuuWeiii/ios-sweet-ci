diff --git a/bsd/dev/polaris_gpu_cm3.c b/bsd/dev/polaris_gpu_cm3.c
--- a/bsd/dev/polaris_gpu_cm3.c
+++ b/bsd/dev/polaris_gpu_cm3.c
@@ -910,6 +910,56 @@
 		}
 	}
 
+	/* OOB power-on, the quirk path: the vote indices that the firmware
+	 * accepts on this phone are 1 and 1 (level 0 is "off"; larger numbers
+	 * are outside its tables - tested 2026-10-26).  ACK is info bit 30. */
+	if (mode == 32 || mode == 33) {
+		cm3_wr(gmu, cm3_reg(GMU_BOOT_SLUMBER), 0u);
+		cm3_wr(gmu, cm3_reg(GMU_GX_VOTE_IDX), 1u);
+		cm3_wr(gmu, cm3_reg(GMU_MX_VOTE_IDX), 1u);
+		cm3_wr(gmu, cm3_reg(GMU_HOST2GMU_INTR_SET), 1u << 22);
+		uint32_t info = 0;
+		for (int i = 0; i < 2000; i++) {
+			info = cm3_rd(gmu, cm3_reg(GMU_GMU2HOST_INFO));
+			if (info & (1u << 30)) {
+				break;
+			}
+			delay(1);
+		}
+		printf("POLARIS GPUPWR: boot_slumber ack=%08x power=%08x\n",
+		    info, cm3_rd(gmu, cm3_reg(0x1F8ECu)));
+		cm3_wr(gmu, cm3_reg(GMU_GMU2HOST_INTR_CLR), 1u << 30);
+		cm3_wr(gmu, cm3_reg(GMU_HOST2GMU_INTR_SET), 1u << 30);
+		if (info & (1u << 30)) {
+			/* GPU_SET OOB: set bit 16, ack info bit 24 */
+			cm3_wr(gmu, cm3_reg(GMU_HOST2GMU_INTR_SET), 1u << 16);
+			uint32_t set = 0;
+			for (int i = 0; i < 2000; i++) {
+				set = cm3_rd(gmu, cm3_reg(GMU_GMU2HOST_INFO));
+				if (set & (1u << 24)) {
+					break;
+				}
+				delay(1);
+			}
+			printf("POLARIS GPUPWR: gpu_set ack=%08x power=%08x\n",
+			    set, cm3_rd(gmu, cm3_reg(0x1F8ECu)));
+			cm3_wr(gmu, cm3_reg(GMU_GMU2HOST_INTR_CLR), 1u << 24);
+			cm3_wr(gmu, cm3_reg(GMU_HOST2GMU_INTR_SET), 1u << 24);
+		}
+		vm_offset_t gpureg = ml_io_map(0x05000000ULL, 0x00040000ULL);
+		vm_offset_t gcc = ml_io_map(GPUCC_PA, GPUCC_SIZE);
+		printf("POLARIS GPUPWR: rbbm=%08x gx_gdscr=%08x power=%08x ao=%08x fence=%08x\n",
+		    gpureg ? cm3_rd(gpureg, 0x210u * 4u) : 0xdead,
+		    gcc ? cm3_rd(gcc, 0x100cu) : 0xdead,
+		    cm3_rd(gmu, cm3_reg(0x1F8ECu)),
+		    cm3_rd(gmu, cm3_reg(GMU_AO_HOST_INTR_STATUS)),
+		    cm3_rd(gmu, cm3_reg(GMU_AHB_FENCE_STATUS)));
+		if (mode == 33) {
+			sweet_dbg_dump_now();
+			return;
+		}
+	}
+
 	/* M3: HFI queues. Clear the msg-queue interrupt mask, start HFI, wait. */
 	if (mode == 6) {
 		cm3_wr(gmu, cm3_reg(GMU_HFI_CTRL_STATUS), 0u);
