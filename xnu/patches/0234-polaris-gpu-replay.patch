+/* ---- 0234: replay the Mesa command stream from bring-up ----------------- */
+/* The stream below is the one a real Mesa GL context submitted on this GPU (captured by 0228):
+   main IB (255 dwords) plus the five indirect buffers it chains. The indirect buffers are
+   relocated into one scratch BO and the CP_INDIRECT_BUFFER payloads patched accordingly, so the
+   experiment needs no iOS userspace at all: bring-up finishes in seconds. */
+static bool gpu_replay_done;
+
+static uint32_t
+gpu_replay_parity(uint32_t v)
+{
+	return (0x9669u >> (0xfu & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^
+	    (v >> 16) ^ (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1u;
+}
+
+static void
+gpu_replay_mask(uint32_t *p, uint32_t words, uint32_t mask, uint32_t *patched)
+{
+	for (uint32_t i = 0; i + 1 < words; ) {
+		uint32_t w = p[i];
+		if ((w >> 28) == 7 && ((w >> 24) & 0xF) == 0) {
+			uint32_t op = (w >> 16) & 0x7f;
+			uint32_t cnt = w & 0x3fff;
+			if (op == mask) {
+				p[i] = 0x70000000u | cnt | (gpu_replay_parity(cnt) << 15) |
+				    (0x10u << 16) | (gpu_replay_parity(0x10u) << 23);
+				for (uint32_t k = 1; k <= cnt; k++) {
+					p[i + k] = 0;
+				}
+				(*patched)++;
+			}
+			i += 1 + cnt;
+		} else if ((w >> 28) == 4) {
+			i += 1 + (w & 0x7f);
+		} else {
+			i += 1;
+		}
+	}
+}
+
+static bool
+gpu_draw_replay(vm_offset_t core, vm_offset_t blob)
+{
+	uint32_t on = 0, mask1 = 0, mask2 = 0, cut = 0;
+	if (!PE_parse_boot_argn("sweetreplay", &on, sizeof(on)) || on == 0 || gpu_replay_done) {
+		return true;
+	}
+	gpu_replay_done = true;
+	(void)PE_parse_boot_argn("sweetreplaycut", &cut, sizeof(cut));
+	(void)PE_parse_boot_argn("sweetreplaymask", &mask1, sizeof(mask1));
+	(void)PE_parse_boot_argn("sweetreplaymask2", &mask2, sizeof(mask2));
+	if (cut == 0) {
+		cut = sizeof(replay_main) / sizeof(replay_main[0]);
+	}
+	if (cut > 255) {
+		cut = 255;
+	}
+
+	struct gpu_bo *bo = gpu_bo_alloc(0x4000);
+	if (bo == NULL) {
+		printf("SWEET GPU: REPLAY: no BO\n");
+		return false;
+	}
+	uint8_t *base = (uint8_t *)bo->kva;
+	const uint32_t ib_off[5] = { 0x400, 0x800, 0xc00, 0x1000, 0x1400 };
+	const uint32_t ib_size[5] = {
+		sizeof(replay_ib0) / sizeof(replay_ib0[0]), sizeof(replay_ib1) / sizeof(replay_ib1[0]),
+		sizeof(replay_ib2) / sizeof(replay_ib2[0]), sizeof(replay_ib3) / sizeof(replay_ib3[0]),
+		sizeof(replay_ib4) / sizeof(replay_ib4[0])
+	};
+	bzero(base, 0x4000);
+	for (unsigned i = 0; i < sizeof(replay_main) / sizeof(replay_main[0]); i++) {
+		*(uint32_t *)(base + 4u * i) = replay_main[i];
+	}
+	const uint32_t *ibs[5] = { replay_ib0, replay_ib1, replay_ib2, replay_ib3, replay_ib4 };
+	for (unsigned i = 0; i < 5; i++) {
+		for (uint32_t k = 0; k < ib_size[i]; k++) {
+			*(uint32_t *)(base + ib_off[i] + 4u * k) = ibs[i][k];
+		}
+	}
+	/* relocate the five CP_INDIRECT_BUFFER payloads of the main IB */
+	{
+		uint32_t *m = (uint32_t *)base;
+		unsigned seen = 0;
+		for (uint32_t i = 0; i + 3 < cut; ) {
+			uint32_t w = m[i];
+			if ((w >> 28) == 7 && ((w >> 24) & 0xF) == 0) {
+				uint32_t op = (w >> 16) & 0x7f;
+				uint32_t cnt = w & 0x3fff;
+				if (op == 0x3f && cnt >= 3 && seen < 5) {
+					uint64_t addr = bo->va + ib_off[seen];
+					m[i + 1] = (uint32_t)addr;
+					m[i + 2] = (uint32_t)(addr >> 32);
+					m[i + 3] = ib_size[seen];
+					seen++;
+				}
+				i += 1 + cnt;
+			} else if ((w >> 28) == 4) {
+				i += 1 + (w & 0x7f);
+			} else {
+				i += 1;
+			}
+		}
+		printf("SWEET GPU: REPLAY: relocated %u/%u IBs, bo va %#x\n", seen, 5u, bo->va);
+	}
+	uint32_t patched = 0;
+	if (mask1) {
+		uint32_t *m = (uint32_t *)base;
+		gpu_replay_mask(m, cut, mask1, &patched);
+		for (unsigned i = 0; i < 5; i++) {
+			gpu_replay_mask((uint32_t *)(base + ib_off[i]), ib_size[i], mask1, &patched);
+		}
+	}
+	if (mask2) {
+		uint32_t *m = (uint32_t *)base;
+		gpu_replay_mask(m, cut, mask2, &patched);
+		for (unsigned i = 0; i < 5; i++) {
+			gpu_replay_mask((uint32_t *)(base + ib_off[i]), ib_size[i], mask2, &patched);
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	*(volatile uint32_t *)(blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FENCE) = 0;
+	bool idle = gpu_cp_submit(core, blob, bo->va, cut);
+	uint32_t seq = gpu_cp_seq;
+	bool fenced = gpu_cp_wait_fence(blob, seq, 4000);
+	printf("SWEET GPU: REPLAY: dwords %u masks %#x/%#x patched %u: submit %s, fence %u %s\n",
+	    cut, mask1, mask2, patched, idle ? "drained" : "STUCK", seq,
+	    fenced ? "retired" : "TIMED OUT");
+	printf("SWEET GPU: REPLAY: cp int %#x status1 %#x hw_fault %#x rptr %#x wptr %#x "
+	    "ib1 %#x/%#x ib2 %#x/%#x\n",
+	    gpu_cp_rd(core, 0x20ccu), gpu_cp_rd(core, 0x2094u), gpu_cp_rd(core, 0x2084u),
+	    gpu_cp_rd(core, 0x2018u), gpu_cp_rd(core, 0x201cu),
+	    gpu_cp_rd(core, 0x24a0u), gpu_cp_rd(core, 0x250cu),
+	    gpu_cp_rd(core, 0x24acu), gpu_cp_rd(core, 0x2510u));
+	return fenced;
 }
 
