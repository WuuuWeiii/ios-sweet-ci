+/* 0227: the a630 programming the 3D pipeline needs on top of the CP self-tests.
+ * Subset of Linux a6xx hw_init (no HWCG/UBWC yet); values are the a630 ones. */
+static void
+gpu_a6xx_draw_init(vm_offset_t core)
+{
+	/* turn on 64 bit addressing in every block */
+	gpu_wr_quiet(core, 0x2108u, 0x1u);
+	gpu_wr_quiet(core, 0x3004u, 0x1u);
+	gpu_wr_quiet(core, 0x21804u, 0x1u);
+	gpu_wr_quiet(core, 0x23814u, 0x1u);
+	gpu_wr_quiet(core, 0x27804u, 0x1u);
+	gpu_wr_quiet(core, 0x2f814u, 0x1u);
+	gpu_wr_quiet(core, 0x29804u, 0x1u);
+	gpu_wr_quiet(core, 0x25804u, 0x1u);
+	gpu_wr_quiet(core, 0x3800u, 0x1u);
+	gpu_wr_quiet(core, 0x2b804u, 0x1u);
+	gpu_wr_quiet(core, 0x2d804u, 0x1u);
+	gpu_wr_quiet(core, 0x3e040u, 0x1u);
+	/* VBIF / perf counters / UCHE */
+	gpu_wr_quiet(core, 0x3e00cu, 0x00000000u);
+	gpu_wr_quiet(core, 0x40u, 0x00000003u);
+	gpu_wr_quiet(core, 0xc0a8u, 0x00000009u);
+	gpu_wr_quiet(core, 0x142cu, 0xffffffffu);
+	gpu_wr_quiet(core, 0x3860u, 0x00000804u);
+	gpu_wr_quiet(core, 0x385cu, 0x00000004u);
+	gpu_wr_quiet(core, 0x2308u, 0x010000c0u);
+	gpu_wr_quiet(core, 0x2304u, 0x8040362cu);
+	gpu_wr_quiet(core, 0x230cu, 0x00000080u);
+	gpu_wr_quiet(core, 0x27800u, 0x00180000u);
+	gpu_wr_quiet(core, 0x2634u, 0x00000001u);
+	gpu_wr_quiet(core, 0x1400u, 0x00000001u);
+	gpu_wr_quiet(core, 0x7cu, 0x401fffffu);
+	gpu_wr_quiet(core, 0x3864u, 0x00000081u);
+	gpu_wr_quiet(core, 0x3e000u, 0x00000000u);
+	gpu_wr_quiet(core, 0x3e004u, 0x00000000u);
+	gpu_wr_quiet(core, 0x3814u, 0xffffffc0u);
+	gpu_wr_quiet(core, 0x3818u, 0x0001ffffu);
+	gpu_wr_quiet(core, 0x3824u, 0xfffff000u);
+	gpu_wr_quiet(core, 0x3828u, 0x0001ffffu);
+	gpu_wr_quiet(core, 0x381cu, 0xfffff000u);
+	gpu_wr_quiet(core, 0x3820u, 0x0001ffffu);
+	gpu_wr_quiet(core, 0x382cu, 0x00100000u);
+	gpu_wr_quiet(core, 0x3830u, 0x00000000u);
+	gpu_wr_quiet(core, 0x3834u, 0x001fffffu);
+	gpu_wr_quiet(core, 0x3838u, 0x00000000u);
+	/* CP protection: only the ranges Linux protects; the last span is infinite */
+	gpu_wr_quiet(core, 0x213cu, 0xbu);   /* CP_PROTECT_CNTL: enable+fault+inf last span */
+	{
+		static const uint32_t protect[] = {
+			0x13fc0000u,
+			0x00140501u,
+			0x0bd0050bu,
+			0x8000050eu,
+			0x80000510u,
+			0x80000534u,
+			0x82080800u,
+			0x802008a0u,
+			0x809008abu,
+			0x02b808deu,
+			0x81340900u,
+			0x89c8098du,
+			0x80040e00u,
+			0x80300e03u,
+			0x830c3c00u,
+			0x7ffc3cc4u,
+			0x873c8630u,
+			0x80008e00u,
+			0x80008e08u,
+			0x807c8e50u,
+			0x876c9624u,
+			0x80049e70u,
+			0x861c9e78u,
+			0x873ca630u,
+			0x8000ae02u,
+			0x8cbcae50u,
+			0x8000b604u,
+			0x8004be02u,
+			0xdf7cbe20u,
+			0xaffcf000u,
+			0x7ffcfc00u,
+		};
+		const uint32_t base = 0x2140u;   /* CP_PROTECT(0) */
+		for (unsigned i = 0; i < sizeof(protect) / sizeof(protect[0]); i++) {
+			if (protect[i] != 0) {
+				gpu_wr_quiet(core, base + i * 4, protect[i]);
+			}
+		}
+		gpu_wr_quiet(core, base + 31u * 4, 0x80011c00u);   /* last span: infinite */
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("SWEET GPU: a6xx draw init done (addr modes, uche, cp pool/protect, hang detect)\n");
+}
