diff --git a/bsd/dev/polaris_gpu_cm3.c b/bsd/dev/polaris_gpu_cm3.c
--- a/bsd/dev/polaris_gpu_cm3.c
+++ b/bsd/dev/polaris_gpu_cm3.c
@@ -58,6 +58,11 @@
 #define GMU_GMU2HOST_MASK   0x1F993u
 #define GMU_GMU2HOST_INFO   0x1F992u
 #define GMU_GENERAL_7       0x1F9CCu
+#define GMU_GMU2HOST_CLR    0x1F991u
+#define GMU_AO_AHB_FENCE_CTRL 0x23B10u
+#define GMU_AHB_FENCE_STATUS  0x23B13u
+#define GMU_AO_HOST_INTR_STATUS 0x23B05u
+#define GMU_AO_HOST_INTR_MASK 0x23B06u
 #define GMU_AHB_FENCE_RANGE0 0x23B11u
 #define GMU_GX_SPTPRAC_POWER 0x1A881u
 #define GMU_SPTPRAC_STATUS   0x1F8D0u
@@ -516,6 +521,11 @@
 	    w[6], w[7], w[8], w[9], w[10], w[11]);
 
 	/* Program the GMU before releasing reset. */
+	/* The GMU's AHB (DRAM) window is fenced while the GPU is powered down.
+	 * Writing 0 puts the AO fence in ALLOW mode; otherwise the firmware's
+	 * first DRAM access (the HFI table) takes a bus error and its CM3
+	 * reports a fault. */
+	cm3_wr(gmu, cm3_reg(GMU_AO_AHB_FENCE_CTRL), 0u);
 	cm3_wr(gmu, cm3_reg(GMU_CM3_FW_INIT), 0);
 	cm3_wr(gmu, cm3_reg(GMU_CM3_BOOT_CONFIG), 2u);           /* TCM_BOOT */
 	cm3_wr(gmu, cm3_reg(GMU_HFI_QTBL_ADDR), (uint32_t)qbase);
@@ -610,6 +620,11 @@
 		return;
 	}
 
+	printf("POLARIS GPUM2b: fence_ctrl=%08x fence_status=%08x ao_status=%08x ao_mask=%08x\n",
+	    cm3_rd(gmu, cm3_reg(GMU_AO_AHB_FENCE_CTRL)),
+	    cm3_rd(gmu, cm3_reg(GMU_AHB_FENCE_STATUS)),
+	    cm3_rd(gmu, cm3_reg(GMU_AO_HOST_INTR_STATUS)),
+	    cm3_rd(gmu, cm3_reg(GMU_AO_HOST_INTR_MASK)));
 	/* Interrupts may carry a CM3 fault from earlier in this boot. */
 	printf("POLARIS GPUM2b: after CM3 boot: intr=%08x\n",
 	    cm3_rd(gmu, cm3_reg(GMU_GMU2HOST_INFO)));
