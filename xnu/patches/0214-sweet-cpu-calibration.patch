+/* Fixed-work timing: the same value (in ms) on every boot means the CPU runs at the same speed. */
+static void
+sweet_cpu_cal(const char *when)
+{
+	volatile uint64_t acc = 1;
+	uint64_t t0 = mach_absolute_time();
+	for (uint64_t i = 0; i < (1ull << 24); i++) {
+		acc = acc * 6364136223846793005ull + i + (acc >> 17);
+	}
+	uint64_t t1 = mach_absolute_time();
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	printf("SWEET CAL: %s 16M iters %llu ms (acc %llx)\n", when, ns / 1000000ull, (unsigned long long)acc);
+}
