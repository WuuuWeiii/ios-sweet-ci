 	    (void *)smmu, (void *)gpu, (void *)qf, (void *)db);
+	{
+		thread_t fs_thread = NULL;
+
+		if (kernel_thread_start(sweet_fs_probe_thread, NULL, &fs_thread) == KERN_SUCCESS) {
+			thread_deallocate(fs_thread);
+			printf("SWEET FS: probe scheduled\n");
