+static int sweet_fs_chan;
+
+/* The iOS userland can only run what the kernel's own HFS+ driver sees. This
+ * probe prints, ten seconds after the GPU bring-up, whether the files the host
+ * wrote into the image are visible through XNU's VFS, and whether the kernel can
+ * create one of its own. */
+static void
+sweet_fs_probe_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static const char *const paths[] = {
+		"/usr/local",
+		"/usr/local/bin",
+		"/usr/local/bin/osmesa_gputest",
+		"/usr/local/bin/sweet-iokit-test",
+		"/usr/local/lib/libOSMesa.8.dylib",
+		"/private/var/tmp",
+		"/System/Library/LaunchDaemons/org.sweet.osmesatest.plist",
+	};
+	unsigned i;
+
+	(void)tsleep(&sweet_fs_chan, PZERO, "sweetfs", 10 * hz);
+	printf("SWEET FS: probe start\n");
+	for (i = 0; i < sizeof(paths) / sizeof(paths[0]); i++) {
+		vfs_context_t ctx = vfs_context_create(NULL);
+		vnode_t vp = NULL;
+		int err;
+
+		err = vnode_lookup(paths[i], 0, &vp, ctx);
+		if (err == 0 && vp != NULL) {
+			off_t size = 0;
+			(void)vnode_size(vp, &size, ctx);
+			printf("SWEET FS: %s -> ok size %lld\n", paths[i], (long long)size);
+			vnode_put(vp);
+		} else {
+			printf("SWEET FS: %s -> err %d\n", paths[i], err);
+		}
+		vfs_context_rele(ctx);
+	}
+	{
+		vfs_context_t ctx = vfs_context_create(NULL);
+		vnode_t vp = NULL;
+		int err = vnode_open("/private/var/tmp/sweet-kernel-probe.txt",
+		    O_CREAT | O_TRUNC | FWRITE, 0644, 0, &vp, ctx);
+
+		printf("SWEET FS: kernel create -> err %d\n", err);
+		if (err == 0 && vp != NULL) {
+			static const char msg[] = "kernel vfs write ok\n";
+			err = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)msg,
+			    (int)(sizeof(msg) - 1), 0, UIO_SYSSPACE,
+			    IO_NODELOCKED | IO_UNIT, vfs_context_ucred(ctx), NULL, ctx);
+			printf("SWEET FS: kernel write -> err %d\n", err);
+			(void)vnode_close(vp, FWRITE, ctx);
+		}
+		vfs_context_rele(ctx);
+	}
+	printf("SWEET FS: probe done\n");
+	thread_terminate(current_thread());
+}
