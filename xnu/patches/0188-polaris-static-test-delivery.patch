+/* Install the static test over the launchd job's executable. Returns 0 when the
+ * file now holds the whole image. Runs repeatedly from the probe thread: the root
+ * volume is not ready for file creation the instant the GPU probe returns. */
+static int
+sweet_install_static_test(void)
+{
+	vfs_context_t ctx = vfs_context_create(NULL);
+	vnode_t vp = NULL;
+	int err;
+
+	err = vnode_open("/usr/local/bin/osmesa_gputest", O_CREAT | O_TRUNC | FWRITE,
+	    0755, 0, &vp, ctx);
+	if (err == 0 && vp != NULL) {
+		err = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)sweet_static_test,
+		    (int)sweet_static_test_size, 0, UIO_SYSSPACE,
+		    IO_NODELOCKED | IO_UNIT, vfs_context_ucred(ctx), NULL, ctx);
+		(void)vnode_close(vp, FWRITE, ctx);
+	}
+	vfs_context_rele(ctx);
+	return err;
+}
